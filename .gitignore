# Python caches and local environments
__pycache__/
*.py[cod]
.venv/

# Re-creatable data artifacts and raw data caches.
# NOTE: these paths were committed before these rules existed, so the files
# remain tracked and these entries only affect newly created files. See the
# "Known constraints" section of CLAUDE.md.
data_processing/curr_data/raw/
data_processing/curr_data/processed/
data_processing/gtfs/
data_processing/gtfs_stations/
seattle/data/raw/
# Trailing /* rather than / so the negation below can take effect: git cannot
# re-include a file whose parent *directory* is excluded.
seattle/data/processed/*
# ...except the two artifacts the backend actually reads at runtime, which
# backend.Dockerfile copies into the image.
!seattle/data/processed/seattle_heatmap_grid.geojson
!seattle/data/processed/seattle_heatmap_grid_250m.geojson
!seattle/data/processed/seattle_heatmap_built_mass.json

# Re-creatable frontend map assets exported by Seattle data scripts
public/seattle/seattle-buildings*.geojson
public/seattle/seattle-building-heights.json
public/seattle/seattle-building-regions-summary.json

# Local, per-developer Claude Code settings
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

